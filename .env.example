# Local Docker Compose defaults are for development on loopback only.
# Set a strong workspace token before connecting from a hosted interface.
CANOPY_API_TOKEN=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://canopy-evidence.marvelousoffer1.chatgpt.site
# Optional LLM extraction. Without this key, labelled pattern extraction is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional replacement credentials for the local PostGIS/MinIO services.
POSTGRES_PASSWORD=canopy-local-development
MINIO_ROOT_USER=canopylocal
MINIO_ROOT_PASSWORD=canopy-local-storage-password
